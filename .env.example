# Copy to .env and fill in the keys. Never commit .env.

# Required for answering questions (Phase 2 onwards)
GROQ_API_KEY=

# Groq models (both must support strict json_schema structured outputs)
CLASSIFIER_MODEL=openai/gpt-oss-20b
GENERATOR_MODEL=openai/gpt-oss-120b

# Embeddings: "local" runs BAAI/bge-small-en-v1.5 on this machine (no key needed);
# "voyage" uses the Voyage AI API (needs VOYAGE_API_KEY, default model voyage-4).
# After switching provider or model, re-run: python -m ingest --rebuild
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
VOYAGE_API_KEY=

# Storage (relative paths are resolved from the project root)
DATA_DIR=data
SOURCES_PATH=data/sources.yaml

# Retrieval. MIN_SIMILARITY: below this top-result similarity the answer is "not found"
# (calibrated for bge-small: answerable >= 0.74, off-topic <= 0.61; re-tuned in Phase 6)
RETRIEVAL_TOP_K=8
MIN_SIMILARITY=0.65
# Optional cross-encoder reranker, off by default. Most accurate tested:
# BAAI/bge-reranker-v2-m3-int8 (~11 s per question on CPU; see Docs/data_research.md §4.3).
RERANKER_MODEL=
